    {
      plan: 'full',
      name: 'The Message',
      price: '$39',
      sub: 'Hear their voice one last time. See their face. Feel like they never fully left.',
      badge: 'Most chosen',
      features: [
        'Everything in The Letter',
        'A 75-second personalised video message',
        "Your pet's voice — matched to their personality",
        'A photorealistic portrait, created from your photos',
      ],
      cta: 'Choose the message',
    },
    {
      plan: 'living-memory',
      name: 'The Living Memory',
      price: '$69',
      sub: 'Your real videos of them, woven into their final message. The closest thing to having them back.',
      badge: 'Most loved',
      features: [
        'Everything in The Message',
        'Your real videos woven into the message',
        'Opens & closes with moments you filmed',
        '75-second cinematic video',
        'Private link — no expiry, yours forever',
        'Delivered within 72 hours',
      ],
      cta: 'Create their living memory',
    },
  ],
  priceNote: 'One time · No subscription · Delivered within 24 hours',
  faqLabel: 'QUESTIONS',
  faqH1: 'You might be wondering.',
  faqs: [
    { q: 'Is this only for pets who have passed away?', a: 'Yes. Nazura AI was created specifically for pet loss — for families who are grieving and need one final moment of comfort. Every message is crafted with that tenderness in mind.' },
    { q: 'Will this make my grief worse?', a: 'Our families told us the opposite. 94% said it brought them peace — not more pain. Many described it as the goodbye they never got to have.' },
    { q: 'How long does it take?', a: '24 hours or less. We review every message personally before it reaches you.' },
    { q: 'Is the message really personalised?', a: 'Every word. Every detail. We build it from everything you tell us — their nicknames, habits, the funny things they did. No two messages are ever the same.' },
    { q: "What if I don't have videos?", a: 'Photos are enough. Videos make the experience richer, but they are never required. Many families have created beautiful messages with photos alone.' },
    { q: 'Is it private?', a: 'Always. Only you receive the link. We never share, publish, or use your content for anything beyond creating your message.' },
    { q: "What if I'm not happy with the result?", a: "We'll make it right. If the portrait doesn't look like your pet, we regenerate it — free of charge. Your peace of mind matters more than anything else." },
