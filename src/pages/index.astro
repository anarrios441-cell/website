            <line x1="26" y1="5" x2="26" y2="9" stroke="#C4944A" stroke-width="1.1" stroke-linecap="round" opacity="0.65"></line>
            <line x1="21" y1="7" x2="22.6" y2="9.5" stroke="#C4944A" stroke-width="0.85" stroke-linecap="round" opacity="0.38"></line>
