  recvSub: 'Eles foram. Mas não disseram tudo. Escolha como quer ouvir o restante.',
  plans: [
    {
      plan: 'letter',
      name: 'A Carta',
      price: '$19',
      sub: 'A última carta que eles nunca puderam escrever — agora finalmente nas suas mãos.',
      badge: '',
      features: [
        'Uma carta personalizada, escrita como se fosse dele',
        'Criada a partir das suas memórias e da personalidade dele',
        'Um link privado, entregue no seu e-mail',
        'Seu para sempre — sem prazo, sem assinatura',
      ],
      cta: 'Escolher a carta',
    },
    {
      plan: 'full',
      name: 'A Mensagem',
      price: '$39',
      sub: 'Ouça a voz deles uma última vez. Veja o rosto deles. Sinta que eles nunca foram completamente embora.',
      badge: 'Mais escolhido',
      features: [
        'Tudo da Carta',
        'Uma mensagem em vídeo personalizada de 75 segundos',
        'A voz do seu pet — adaptada à personalidade dele',
        'Um retrato fotorrealista criado a partir das suas fotos',
      ],
      cta: 'Escolher a mensagem',
    },
    {
      plan: 'living-memory',
      name: 'A Memória Viva',
      price: '$69',
      sub: 'Seus vídeos reais deles, tecidos na mensagem final. O mais perto de tê-los de volta.',
      badge: 'Mais amado',
      features: [
        'Tudo de A Mensagem',
        'Seus vídeos reais tecidos na mensagem',
        'Abre e fecha com momentos que você filmou',
        'Vídeo cinematográfico de 75 segundos',
        'Link privado — sem prazo, seu para sempre',
        'Entregue em até 72 horas',
      ],
      cta: 'Criar a memória viva',
    },
  ],
  priceNote: 'Uma vez · Sem assinatura · Entregue em até 24 horas',
  faqLabel: 'DÚVIDAS',
  faqH1: 'Você pode estar se perguntando.',
  faqs: [
    { q: 'Isso é só para pets que faleceram?', a: 'Sim. A Nazura AI foi criada especificamente para o luto de pets — para famílias que estão de luto e precisam de um último momento de conforto. Cada mensagem é criada com esse cuidado.' },
    { q: 'Isso vai piorar meu luto?', a: 'Nossas famílias nos disseram o contrário. 94% disseram que trouxe paz — não mais dor. Muitos descreveram como a despedida que nunca puderam ter.' },
