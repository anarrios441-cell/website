  heroH1b: 'presence alive.',
  heroSub:
    'For the pets who left too soon. For the people who still hear them.',
  heroCta: 'Hear from them one last time',
  heroNote: 'Delivered within 24 hours · Private · Yours forever',
  howLabel: 'HOW IT WORKS',
  howH1a: 'Three steps. One message.',
  howH1b: 'A lifetime of comfort.',
  howSub: 'For the pets who passed. For the people who miss them every day.',
  steps: [
    { n: '01', title: 'Tell us about the pet you lost', body: 'Their name, their personality, the memories you carry. The details only you know.' },
    { n: '02', title: 'Share your photos', body: "Send us the photos you can't stop looking at. They become the heart of the message." },
    { n: '03', title: 'Receive their message', body: "A goodbye, finally delivered. It arrives as a surprise — because that's how love works." },
  ],
  testLabel: 'WHAT FAMILIES ARE SAYING',
  testH1: '"They said it better than we ever could."',
  testRating: '18 reviews · 94% satisfaction · Early Beta',
  testimonials: [
    { quote: "Surprising — I didn't know I needed to read this until I did. What a wonderful feeling. 🥺", name: 'Thayze · Luna, 8 years' },
    { quote: 'I watched it four times. Each time I found something new that was exactly her.', name: 'Sarah · Australia' },
    { quote: 'Loved it.', name: 'Marcela · Toy, 18 years' },
    { quote: "I didn't expect to laugh. But I did. And then I cried. And then I laughed again.", name: 'Miguel · Brazil' },
    { quote: "He said the thing I needed to hear. I don't know how, but he did.", name: 'Emma · United Kingdom' },
  ],
  testNote: 'These are real messages from our first beta families.',
  recvLabel: 'WHAT YOU RECEIVE',
  recvH1: 'Three ways to hear from them — one last time.',
  recvSub: "They left. But they didn't say everything. Choose how you want to hear the rest.",
