/* default-render language */
const t = en

/* deterministic gold particles */
const PARTICLES = [
  { top: '12%', left: '8%', size: 3, dur: 6, delay: 0, op: 0.3 },
  { top: '22%', left: '82%', size: 2, dur: 7, delay: 1.2, op: 0.25 },
  { top: '34%', left: '45%', size: 4, dur: 5, delay: 0.6, op: 0.35 },
  { top: '48%', left: '18%', size: 2, dur: 8, delay: 2.1, op: 0.28 },
  { top: '58%', left: '72%', size: 3, dur: 6.5, delay: 0.3, op: 0.4 },
  { top: '15%', left: '60%', size: 2, dur: 7.5, delay: 1.8, op: 0.22 },
  { top: '70%', left: '38%', size: 3, dur: 5.5, delay: 3.2, op: 0.32 },
  { top: '80%', left: '88%', size: 2, dur: 6.8, delay: 0.9, op: 0.26 },
  { top: '40%', left: '92%', size: 3, dur: 7.2, delay: 2.6, op: 0.3 },
  { top: '64%', left: '6%', size: 2, dur: 8, delay: 1.5, op: 0.24 },
  { top: '88%', left: '52%', size: 4, dur: 6, delay: 3.8, op: 0.34 },
  { top: '28%', left: '28%', size: 2, dur: 7, delay: 0.4, op: 0.27 },
]
---

<Layout>
  <main>
    <!-- ===================== HEADER ===================== -->
    <header id="site-header" class="site-header fixed top-0 left-0 right-0 z-50">
      <div class="max-w-6xl mx-auto px-5 sm:px-8 h-[72px] flex items-center justify-between">
        <Logo width={200} height={48} />
        <div class="flex items-center gap-4 sm:gap-6">
          <!-- Lang toggle — hidden for EN-only launch. To re-enable: remove style="display:none" -->
          <div class="flex items-center gap-2" style="display:none">
            <button id="lang-en" class="lang-btn" style="color: var(--gold)" aria-label="English">EN</button>
            <span style="color: var(--text-faint)">|</span>
            <button id="lang-pt" class="lang-btn" style="color: var(--text-muted)" aria-label="Português">PT</button>
          </div>
          <a href="https://nazuraai.com/en?plan=full" class="btn-gold btn-gold-sm hidden sm:inline-block" data-i18n="navCta" data-form-plan="full">{t.navCta}</a>
        </div>
      </div>
    </header>

    <!-- ===================== HERO ===================== -->
    <section class="relative h-screen w-full flex items-center justify-center overflow-hidden">
      <img
        class="hero-img"
        src="https://images.unsplash.com/photo-1450778869180-41d0601e046e?w=1920&q=80"
        alt=""
        fetchpriority="high"
      />
      <div class="absolute inset-0" style="background: rgba(0,0,0,0.65)"></div>
      <div class="hero-vignette"></div>
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        {PARTICLES.map((p) => (
          <span
            class="particle"
            style={`top:${p.top};left:${p.left};width:${p.size}px;height:${p.size}px;opacity:${p.op};animation-duration:${p.dur}s;animation-delay:${p.delay}s;`}
          ></span>
        ))}
      </div>

      <div class="relative z-10 px-6 text-center flex flex-col items-center">
        <h1 class="font-serif-italic leading-[1.1]" style="color: var(--text-primary); font-size: clamp(44px, 7vw, 64px)">
          <span data-i18n="heroH1a">{t.heroH1a}</span><br /><span data-i18n="heroH1b">{t.heroH1b}</span>
        </h1>
        <p class="font-sans mt-7 mx-auto" style="color: #ffffff; max-width: 520px; font-weight: 400; font-size: clamp(16px, 2vw, 18px); text-shadow: 0 1px 8px rgba(0,0,0,0.6)" data-i18n="heroSub">{t.heroSub}</p>
        <a href="https://nazuraai.com/criar?plan=full" class="btn-gold mt-10" data-i18n="heroCta" data-form-plan="full">{t.heroCta}</a>
        <p class="font-sans mt-5 text-[13px]" style="color: #ffffff; font-weight: 400; text-shadow: 0 1px 6px rgba(0,0,0,0.8); letter-spacing: 0.5px" data-i18n="heroNote">{t.heroNote}</p>
      </div>

      <div id="scroll-indicator" class="scroll-indicator absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path d="M7 10l5 5 5-5" stroke="var(--gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
    </section>

    <!-- ===================== HOW IT WORKS ===================== -->
    <section id="how-it-works" class="fade-section relative py-[100px] px-6" style="background: var(--bg-section)">
      <div class="max-w-6xl mx-auto">
        <p class="eyebrow text-center mb-4" data-i18n="howLabel">{t.howLabel}</p>
        <h2 class="font-serif-italic text-center mb-5 leading-[1.15]" style="color: var(--text-primary); font-size: clamp(32px, 5vw, 44px); font-weight: 700">
          <span data-i18n="howH1a">{t.howH1a}</span><br /><span data-i18n="howH1b">{t.howH1b}</span>
        </h2>
        <p class="font-sans text-center mb-[60px]" style="color: var(--text-muted); font-weight: 300; font-size: clamp(15px, 2vw, 17px)" data-i18n="howSub">{t.howSub}</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {t.steps.map((s, i) => {
            const imgs = [
              'https://images.pexels.com/photos/16252875/pexels-photo-16252875.jpeg?auto=compress&cs=tinysrgb&w=800',
              'https://images.pexels.com/photos/17650804/pexels-photo-17650804.jpeg?auto=compress&cs=tinysrgb&w=800',
              'https://images.pexels.com/photos/18327709/pexels-photo-18327709.jpeg?auto=compress&cs=tinysrgb&w=800',
            ]
            return (
              <div class="rounded-[2px] overflow-hidden flex flex-col" style="background: var(--bg-card); border: 1px solid var(--gold-border)">
                <div style="height: 200px; overflow: hidden">
                  <img src={imgs[i]} alt="" class="w-full h-full object-cover" style="object-position: center center" />
                </div>
                <div class="p-9 flex flex-col flex-1">
                  <p class="font-sans mb-5" style="color: var(--gold); font-size: 11px; letter-spacing: 3px">{s.n}</p>
                  <h3 class="font-serif-italic mb-3" style="color: var(--text-primary); font-size: 24px" data-i18n={`steps.${i}.title`}>{s.title}</h3>
                  <p class="font-sans" style="color: var(--text-muted); font-weight: 300; font-size: 15px" data-i18n={`steps.${i}.body`}>{s.body}</p>
                </div>
              </div>
            )
          })}
        </div>
      </div>
    </section>

    <!-- ===================== TESTIMONIALS ===================== -->
    <section class="fade-section relative py-[100px]" style="background: var(--bg-primary)">
      <div class="max-w-6xl mx-auto px-6 mb-14">
        <p class="eyebrow text-center mb-4" data-i18n="testLabel">{t.testLabel}</p>
        <h2 class="font-serif-italic text-center mb-5 leading-[1.15]" style="color: var(--text-primary); font-size: clamp(32px, 5vw, 44px)" data-i18n="testH1">{t.testH1}</h2>
      </div>

      <!-- Card carousel -->
      <div class="test-carousel-wrap">
        <div class="test-fade-left"></div>
        <div class="test-fade-right"></div>

        <div id="carousel-en" class="test-carousel-track">
          {[...en.testimonials, ...en.testimonials].map((c) => (
            <div class="test-card">
              <p class="mb-4 text-[13px]"><span class="stars">★★★★★</span></p>
              <p class="font-serif-italic mb-5" style="color: var(--text-primary); font-size: 19px; line-height: 1.6">"{c.quote}"</p>
              <p class="font-sans text-[13px]" style="color: var(--text-muted); font-weight: 400">{c.name}</p>
            </div>
          ))}
        </div>

        <div id="carousel-pt" class="test-carousel-track" style="display:none">
          {[...pt.testimonials, ...pt.testimonials].map((c) => (
            <div class="test-card">
              <p class="mb-4 text-[13px]"><span class="stars">★★★★★</span></p>
              <p class="font-serif-italic mb-5" style="color: var(--text-primary); font-size: 19px; line-height: 1.6">"{c.quote}"</p>
              <p class="font-sans text-[13px]" style="color: var(--text-muted); font-weight: 400">{c.name}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===================== WHAT YOU RECEIVE ===================== -->
    <section class="fade-section relative py-[100px] px-6" style="background: var(--bg-section)">
      <div class="max-w-6xl mx-auto">
        <p class="eyebrow text-center mb-4" data-i18n="recvLabel">{t.recvLabel}</p>
        <h2 class="font-serif-italic text-center mb-5" style="color: var(--text-primary); font-size: clamp(36px, 6vw, 52px)" data-i18n="recvH1">{t.recvH1}</h2>
        <p class="font-sans text-center mb-[60px]" style="color: var(--text-muted); font-weight: 300; font-size: clamp(15px, 2vw, 17px)" data-i18n="recvSub">{t.recvSub}</p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto items-stretch">
          {t.plans.map((pl, pi) => (
            <div class="relative p-9 rounded-[2px] flex flex-col" style={`background: var(--bg-card); border: ${pl.plan === 'living-memory' ? '2px solid var(--gold); box-shadow: 0 0 40px rgba(196,148,74,0.12)' : '1px solid ' + (pl.plan === 'full' ? 'var(--gold-border)' : 'var(--gold-border)')}`}>
              {pl.badge && (
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 font-sans whitespace-nowrap" style="background: var(--gold); color: #0A0806; font-size: 10px; font-weight: 400; letter-spacing: 2px; text-transform: uppercase; padding: 4px 12px; border-radius: 2px" data-i18n={`plans.${pi}.badge`}>{pl.badge}</span>
              )}
              <h3 class="font-serif-italic text-center" style="color: var(--text-primary); font-size: 26px" data-i18n={`plans.${pi}.name`}>{pl.name}</h3>
              <p class="font-sans text-center mt-2" style="color: var(--gold); font-size: 52px; font-weight: 300; line-height: 1.1">{pl.price}</p>
              <p class="font-sans text-center mt-1 mb-7 text-[13px]" style="color: var(--text-muted); font-weight: 300" data-i18n={`plans.${pi}.sub`}>{pl.sub}</p>
              <div style="border-top: 1px solid var(--gold-border)" class="mb-7"></div>
              <ul class="flex flex-col gap-3 mb-8">
                {pl.features.map((f, fi) => (
                  <li class="font-sans flex gap-3" style="color: var(--text-primary); font-weight: 300; font-size: 15px">
                    <span style="color: var(--gold)">✦</span><span data-i18n={`plans.${pi}.features.${fi}`}>{f}</span>
                  </li>
                ))}
              </ul>
              <a href={pl.plan === 'letter' ? 'https://nazuraai.com/criar?plan=letter' : 'https://nazuraai.com/criar?plan=full'} class="btn-gold w-full mt-auto" data-i18n={`plans.${pi}.cta`} data-form-plan={pl.plan}>{pl.cta}</a>
            </div>
          ))}
        </div>
        <p class="font-sans text-center mt-10 text-[12px]" style="color: var(--text-faint); font-weight: 300" data-i18n="priceNote">{t.priceNote}</p>
      </div>
    </section>

    <!-- ===================== FINAL CTA ===================== -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden px-6">
      <img
        src="https://images.pexels.com/photos/16049218/pexels-photo-16049218.jpeg?auto=compress&cs=tinysrgb&w=1920"
        alt=""
        class="absolute inset-0 w-full h-full object-cover"
        style="object-position: center 75%"
      />
      <div class="absolute inset-0" style="background: rgba(0,0,0,0.78)"></div>
      <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at center, rgba(196,148,74,0.07) 0%, transparent 65%)"></div>
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        {PARTICLES.map((p) => (
          <span
            class="particle"
            style={`top:${p.top};left:${p.left};width:${p.size}px;height:${p.size}px;opacity:${p.op};animation-duration:${p.dur}s;animation-delay:${p.delay}s;`}
          ></span>
        ))}
      </div>
      <div class="relative z-10 text-center flex flex-col items-center">
        <div class="mb-8">
