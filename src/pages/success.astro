---
export const prerender = false
import Layout from '../layouts/Layout.astro'
import Logo from '../components/Logo.astro'
---

<Layout>
  <main class="min-h-screen flex items-center justify-center px-6" style="background: var(--bg-primary)">
    <div class="text-center flex flex-col items-center gap-6 max-w-md">
      <Logo width={160} height={38} />
      <div style="width: 48px; height: 1px; background: var(--gold); opacity: 0.6"></div>
      <h1 class="font-serif-italic" style="color: var(--text-primary); font-size: clamp(28px, 5vw, 40px)">
        Their message is on its way.
      </h1>
      <p class="font-sans" style="color: var(--text-muted); font-weight: 300; font-size: 16px; line-height: 1.75">
        Thank you for trusting us with this moment. You'll receive their message within 24 hours. Check your inbox — and take care of yourself.
      </p>
      <a href="/" class="btn-gold mt-4">Return home</a>
    </div>
  </main>
</Layout>
